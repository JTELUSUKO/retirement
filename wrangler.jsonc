// Cloudflare Worker for https://willitlast.app (build with BASE_PATH=/ first). It serves the static site and runs code
// only for /api/*, so pages and files don't count as Worker requests. Each planner load does: one read of the heart's total
// (src/worker/index.ts).
{
  "name": "willitlast",
  "main": "src/worker/index.ts",
  // Served only from its own domain, with no second address on workers.dev
  "workers_dev": false,
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "LOVE", "class_name": "LoveCounter" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LoveCounter"] }],
  // Heart taps per visitor. namespace_id is any number of our choosing, unique in the Cloudflare account.
  "ratelimits": [{ "name": "LOVE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "routes": [{ "pattern": "willitlast.app", "custom_domain": true }],
}
